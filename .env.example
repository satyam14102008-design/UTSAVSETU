# ==============================================================================
# UTSAVSETU — AI-Powered Indian Event, Guest & Budget Management
# Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=utsavsetu_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Live MongoDB connection. If MongoDB is unreachable, UtsavSetu automatically
# falls back to a persistent JSON document store under backend/.data/
MONGODB_URI=mongodb://localhost:27017/utsavsetu_db
DATABASE_NAME=utsavsetu_db

# Meta WhatsApp Business Cloud API Configuration
# In development or when credentials are not configured, UtsavSetu runs in Demo Mode
# generating direct wa.me deep links and simulation logs with full traceability.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=utsavsetu_webhook_verify_secret

# Public URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

